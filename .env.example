# URL de conexão com o Postgres (Neon ou Supabase).
# Formato: postgresql://usuario:senha@host:porta/banco?sslmode=require
# Neon: copie a "Connection string" do painel do projeto.
# Supabase: Project Settings > Database > Connection string (modo "URI").
DATABASE_URL=

# Segredo usado pelo Auth.js para assinar sessões/JWT.
# Gere com: npx auth secret
AUTH_SECRET=

# Chave mestra (32 bytes) que cifra a chave de API do AbacatePay de cada
# tenant antes de gravar no banco (AES-256-GCM). Se vazar o banco, a chave
# de cada creche continua protegida — mas só se essa variável não vazar
# junto. Nunca reaproveite entre ambientes (dev/prod cada um a sua).
# Gere com: openssl rand -base64 32
CHAVE_CRIPTOGRAFIA=

# URL pública HTTPS do app (ex: https://minhacreche.vercel.app), sem
# barra no final. Usada pra montar o endpoint do webhook do AbacatePay e
# o link de /pagar/[token]. A AbacatePay recusa localhost/IP privado como
# endpoint de webhook, então em dev local isso fica vazio de propósito —
# o registro automático do webhook é pulado (com aviso) até existir uma
# URL pública de verdade (deploy na Vercel).
URL_APP=

# Segredo que protege /api/cron/cobrancas (ver vercel.json) — sem essa
# variável configurada, a rota fica bloqueada pra qualquer chamada. Na
# Vercel, configure em Project Settings > Environment Variables; a
# própria Vercel injeta o header "Authorization: Bearer <CRON_SECRET>"
# automaticamente ao disparar o cron, não precisa configurar nada além
# da variável. Gere com: openssl rand -base64 32
CRON_SECRET=
